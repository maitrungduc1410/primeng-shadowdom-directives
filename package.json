{
  "name": "test-psd",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo --host 0.0.0.0 --port 4200",
    "build": "ng build primeng-shadowdom-directives",
    "build:demo": "ng build demo",
    "build:lib": "ng build primeng-shadowdom-directives --configuration production",
    "watch:lib": "ng build primeng-shadowdom-directives --watch --configuration development",
    "test": "ng test",
    "pack:lib": "npm run build:lib && npm pack ./dist/primeng-shadowdom-directives",
    "publish:lib": "npm run build:lib && npm publish ./dist/primeng-shadowdom-directives --access public",
    "build:example": "npm run build:demo",
    "build:pages": "ng build demo --configuration production --base-href /primeng-shadowdom-directives/"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.33",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@primeng/themes": "^20.4.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.39",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.33",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.2",
    "typescript": "~5.9.3"
  }
}